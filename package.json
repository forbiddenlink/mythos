{
  "name": "mythos",
  "version": "1.13.1",
  "private": true,
  "description": "Mythology & Folklore Encyclopedia - Research-backed interactive database",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "prepare": "[ -d .git ] && husky || true",
    "start": "turbo start",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "knip": "knip"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter web exec eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.10",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.1 <9.0.0",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4 <8.0.0",
      "@opentelemetry/core": ">=2.8.0 <3.0.0",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@1": ">=1.1.21 <2",
      "brace-expansion@2": ">=2.1.7 <3",
      "brace-expansion@3": ">=3.0.9 <4",
      "brace-expansion@5": ">=5.0.12 <6",
      "bytes": ">=3.1.2 <4.0.0",
      "dompurify": ">=3.4.17 <4",
      "@vitest/mocker": ">=4.1.12 <5",
      "esbuild": ">=0.28.1 <0.29.0",
      "fast-uri": ">=3.1.4 <5.0.0",
      "fflate": ">=0.8.3 <0.9",
      "flatted@<3.4.2": "3.4.4",
      "js-yaml": ">=5.4.1 <6",
      "jsonwebtoken": ">=10.3.0 <11.0.0",
      "lodash": ">=4.18.0 <5.0.0",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid": ">=3.3.17 <7.0.0",
      "next": "16.4.3",
      "next-intl": ">=4.9.1 <5.0.0",
      "picomatch": ">=4.0.4 <5.0.0",
      "postcss": ">=8.5.18 <9.0.0",
      "postcss-selector-parser@<7.1.6": ">=7.1.6 <8",
      "protobufjs": "^7.6.1",
      "rollup@<2.80.0": "2.80.0",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "serialize-javascript": ">=7.0.5 <8.0.0",
      "sharp": ">=0.35.3 <0.36.0",
      "undici": ">=7.30.1 <8.0.0",
      "uuid": ">=11.1.1 <12.0.0",
      "vite": ">=8.1.6 <9.0.0",
      "yaml": ">=2.8.3 <3.0.0",
      "source-map-js": ">=1.2.2 <2"
    }
  },
  "license": "MIT"
}
