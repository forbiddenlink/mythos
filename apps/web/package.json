{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/csp-hashes.mjs",
    "build:ci": "NEXT_PUBLIC_ORACLE_ENABLED=true next build --webpack && node scripts/csp-hashes.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:start-only": "SKIP_BUILD=true playwright test",
    "e2e:ui": "playwright test --ui",
    "visual": "playwright test --config=playwright.visual.config.ts",
    "visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots=all",
    "generate:embeddings": "tsx scripts/generate-oracle-embeddings.ts",
    "eval:oracle": "tsx eval/run-oracle-eval.ts"
  },
  "dependencies": {
