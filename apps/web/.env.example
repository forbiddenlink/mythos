# Mythos Atlas - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# API Configuration
# =============================================================================

# GraphQL API endpoint (optional — only needed if using the Rust backend instead of the built-in route handler)
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

# =============================================================================
# AI/LLM Configuration (Optional - for Oracle feature)
# =============================================================================

# Anthropic API key for Claude (Oracle feature)
ANTHROPIC_API_KEY=

# Optional: override default Oracle model (default: claude-sonnet-4-6 — verify in Anthropic docs)
# ANTHROPIC_ORACLE_MODEL=claude-3-5-sonnet-20241022

# OpenAI API (optional — semantic Oracle grounding). Prefer OPENAI_EMBEDDINGS_API_KEY for separation.
# OPENAI_EMBEDDINGS_API_KEY=
# OPENAI_API_KEY=

# Upstash Redis — REQUIRED in production for Oracle (shared rate limits across serverless instances).
# Without these, production Oracle requests fail closed with HTTP 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: hard-disable all Anthropic routes (Oracle + story quiz) without a redeploy of app logic.
# ORACLE_KILL_SWITCH=true

# Optional: global daily request cap across all IPs (default 500). Requires Upstash.
# ORACLE_DAILY_REQUEST_CAP=500

# Enable the Oracle AI chat button (set to "true" to show the floating Oracle button).
# Also requires ANTHROPIC_API_KEY (and Upstash in production).
NEXT_PUBLIC_ORACLE_ENABLED=

# PWA install prompt (beforeinstallprompt). Requires a working SW strategy; off by default.
# NEXT_PUBLIC_PWA_INSTALL_PROMPT=true

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================

# Sentry DSN for error tracking (get from sentry.io)
NEXT_PUBLIC_SENTRY_DSN=

# Trace sample rate 0-1. Defaults to 0.15 if unset. These are two distinct
# scopes, not duplicates: server reads the unprefixed name via
# instrumentation.ts; client needs the NEXT_PUBLIC_ prefix to be inlined
# into the browser bundle via ConsentGatedSentry.tsx. Set both to keep
# server and client sampling in sync.
# SENTRY_TRACES_SAMPLE_RATE=0.15
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.15

# Session replay (off unless set true)
# NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=true

# Sentry organization slug
SENTRY_ORG=

# Sentry project slug
SENTRY_PROJECT=

# Sentry auth token (for source map uploads in CI)
SENTRY_AUTH_TOKEN=

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Vercel Analytics / Speed Insights load only after cookie consent (and never when GPC is on).
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID is unused by current code — consent-gated @vercel/analytics instead.
