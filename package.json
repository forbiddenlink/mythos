{
  "name": "mythos",
  "version": "1.3.0",
  "private": true,
  "description": "Mythology & Folklore Encyclopedia - Research-backed interactive database",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "prepare": "[ -d .git ] && husky || true",
    "start": "turbo start",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter web exec eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.1",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@opentelemetry/core": ">=2.8.0",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.4",
      "brace-expansion@>=3.0.0 <=5.0.7": "5.0.9",
      "bytes": ">=3.1.2",
      "dompurify": ">=3.4.13",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=3.1.4",
      "fflate": ">=0.8.3 <0.9",
      "flatted@<3.4.2": "3.4.4",
      "js-yaml": ">=5.2.2",
      "jsonwebtoken": ">=10.3.0",
      "lodash": ">=4.18.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid": ">=3.3.17",
      "next": ">=16.2.11",
      "next-intl": ">=4.9.1",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18",
      "protobufjs": "^7.6.1",
      "rollup@<2.80.0": "2.80.0",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "serialize-javascript": ">=7.0.5",
      "sharp": ">=0.35.3",
      "undici": ">=7.29.0 <8.0.0",
      "uuid": ">=11.1.1",
      "vite": ">=7.3.2",
      "yaml": ">=2.8.3"
    }
  },
  "license": "MIT"
}
