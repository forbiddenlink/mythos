# Mythos Atlas - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# AI/LLM Configuration (Optional - for Oracle feature)
# =============================================================================

# Server-side Oracle credentials; configure one provider.
ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# Optional: pin the provider (anthropic | groq). When pinned, a missing key or
# model construction failure makes the Oracle unavailable (logged) instead of
# switching providers. Unset: Anthropic when keyed, else Groq; an Anthropic
# construction failure then falls back to Groq with an error log.
# ORACLE_PROVIDER=anthropic
# GROQ_ORACLE_MODEL=

# Optional model override; defaults live in src/lib/oracle/provider.ts.
# ANTHROPIC_ORACLE_MODEL=

# OpenAI API (optional — semantic Oracle grounding). Prefer OPENAI_EMBEDDINGS_API_KEY for separation.
# Inert until src/data/oracle-embeddings.json is generated
# (pnpm --filter web generate:embeddings); keyword grounding is primary.
# OPENAI_EMBEDDINGS_API_KEY=
# OPENAI_API_KEY=

# Upstash Redis supplies shared limits and the global daily cap.
# Production requests fail closed without it for both Anthropic and Groq.
# Only development can fall back to in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: disable Oracle and story-quiz AI endpoints. Apply via deployment env.
# ORACLE_KILL_SWITCH=true

# Optional: global daily request cap across all IPs (default 500). Requires Upstash.
# ORACLE_DAILY_REQUEST_CAP=500

# Optional: global daily Oracle token budget (estimated input + output tokens,
# reserved per request and settled to actual usage; default 2000000). Same
# fail-closed production semantics as the request cap; requires Upstash.
# ORACLE_DAILY_TOKEN_CAP=2000000

# Enable the footer Oracle control. The server requires a configured provider;
# configure Upstash for shared production limits.
NEXT_PUBLIC_ORACLE_ENABLED=

# PWA install prompt (beforeinstallprompt). Requires a working SW strategy; off by default.
# NEXT_PUBLIC_PWA_INSTALL_PROMPT=true

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================

# Sentry DSN for error tracking (get from sentry.io)
NEXT_PUBLIC_SENTRY_DSN=

# Trace sample rate 0-1. Defaults to 0.15 if unset. These are two distinct
# scopes, not duplicates: server reads the unprefixed name via
# instrumentation.ts; client needs the NEXT_PUBLIC_ prefix to be inlined
# into the browser bundle via ConsentGatedSentry.tsx. Set both to keep
# server and client sampling in sync.
# SENTRY_TRACES_SAMPLE_RATE=0.15
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.15

# Session replay (off unless set true)
# NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=true

# Sentry organization slug
SENTRY_ORG=

# Sentry project slug
SENTRY_PROJECT=

# Sentry auth token (for source map uploads in CI)
SENTRY_AUTH_TOKEN=

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Vercel Analytics / Speed Insights load only after cookie consent (and never when GPC is on).
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID is unused by current code — consent-gated @vercel/analytics instead.

# --- Product analytics (PostHog) ---
# Without these the app still runs: trackEvent() has no sink and the
# /api/analytics/* routes answer 501 rather than pretending to store events.
# Project API key. Safe to expose; it is a write-only ingest key.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingest hosts. Browser requests are proxied through /ingest (next.config.ts).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com
# Dashboard host, used only for PostHog toolbar links.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Server-side key for the /api/analytics/* beacons. Falls back to the public key.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Google Search Console ownership token, from the "HTML tag" verification
# method. Public by design (Google reads it from the page source). Without it
# no verification tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
